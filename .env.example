# UptimeX — environment template.
# Copy to .env and adjust. NEVER commit real credentials.

# ----- Core -----
APP_ENV=production            # development | production
HTTP_ADDR=:8080

# ----- Storage -----
DB_DRIVER=postgres            # postgres (production) | sqlite (local dev)
# POSTGRES_USER=monitor
# POSTGRES_PASSWORD=change-me-strong-password
# POSTGRES_DB=healthmonitor
POSTGRES_DSN=postgres://monitor:change-me@localhost:5432/healthmonitor?sslmode=disable
# SQLITE_PATH=./healthmonitor.db     # sqlite mode only

# ----- Monitoring engine -----
WORKER_COUNT=20               # bounded worker pool size (50+ endpoints OK)
SCHEDULER_TICK=1s             # scheduling resolution
JOB_QUEUE_SIZE=512

# ----- Security -----
ALLOW_PRIVATE_TARGETS=false   # true ONLY for local dev / internal monitoring
                              # (SSRF guard; blocks private/loopback/metadata targets)
API_KEY=                      # when set, mutating API routes require X-API-Key
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# ----- SaaS mode (multi-tenant) -----
SAAS_MODE=false               # true: signup/login sessions, per-org data scoping,
                              # plan quotas, public status pages; anonymous API
                              # access rejected (operator API_KEY still honored)
SESSION_TTL=168h              # login session lifetime (default 7 days)
SESSION_COOKIE_SECURE=false   # true when serving HTTPS (sets Secure flag)

# ----- Alerting (monitor) -----
ALERT_WEBHOOK_URL=            # e.g. https://hooks.slack.com/services/...
ALERT_WEBHOOK_SECRET=         # optional HMAC-SHA256 signing secret
ALERT_COOLDOWN=5m             # per endpoint+type dedup window
ALERT_HIGH_LATENCY_MS=0       # >0 enables HIGH_LATENCY alerts
# SMTP_HOST=smtp.example.com  # optional email channel
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=uptimex@example.com
# SMTP_TO=oncall@example.com

# ----- Checker-of-checkers (separate failure domain!) -----
# Use a DIFFERENT webhook than ALERT_WEBHOOK_URL so a dead monitor can still
# reach its recipients.
HC_INTERVAL=5s
HC_MISSES_THRESHOLD=3
HC_ALERT_WEBHOOK_URL=
HC_ALERT_WEBHOOK_SECRET=

# ----- Demo seed (docker compose) -----
SEED_DEMO_ENDPOINTS=true
SEED_SELF_URL=http://monitor:8080/health

# ----- Ports (host bindings for compose) -----
MONITOR_PORT=8080
DASHBOARD_PORT=8090
MONITOR_NAME=uptimex-1           # instance label used in /health and alerts
